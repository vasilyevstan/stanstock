DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=stanstock.settings.dev
DJANGO_SECRET_KEY=replace-for-nonlocal-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SESSION_COOKIE_AGE=43200
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=true
DATABASE_URL=postgresql://stanstock:stanstock@db:5432/stanstock
STANSTOCK_DATA_DIR=/app/var/data
STANSTOCK_BACKUP_DIR=/app/var/backups
STANSTOCK_DEMO_MODE=true
STANSTOCK_CODE_REVISION=working-tree
STANSTOCK_LOGIN_RATE_LIMIT_ATTEMPTS=5
STANSTOCK_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
STANSTOCK_LOGIN_TRUSTED_PROXY_IPS=
STANSTOCK_OWNER_USERNAME=admin
STANSTOCK_OWNER_PASSWORD=replace-this-local-password
STANSTOCK_OWNER_EMAIL=
TWELVE_DATA_API_KEY=
